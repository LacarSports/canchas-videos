# Lacar Sports — plantilla de la configuración COMÚN a todas las Raspberry Pi.
#
# Copia este archivo a configs/comun.env (en tu PC) y rellena las claves reales.
# desplegar.sh lo copia a cada Pi como /opt/lacar/comun.env.
# ⚠️ Tiene secretos: configs/ está fuera de git. Respáldalo en tu gestor de contraseñas.
#
# Formato: comentarios SOLO en líneas propias; valores entre comillas simples.

# Cloudflare R2
R2_ACCOUNT_ID='CAMBIAR'
R2_BUCKET='canchas-videos'
R2_ACCESS_KEY='CAMBIAR'
R2_SECRET_KEY='CAMBIAR'
R2_PUBLIC_URL='https://CAMBIAR.r2.dev'

# Supabase
SUPABASE_URL='https://CAMBIAR.supabase.co'
SUPABASE_KEY='CAMBIAR'

# Comportamiento (valores por defecto; una cámara puede sobrescribirlos en su .env)
# Cada cuántos segundos revisa la cámara.
POLL_INTERVAL=30
# Cada cuántos segundos actualiza la tabla heartbeat (panel → Monitoreo).
HEARTBEAT_INTERVAL=1800
# Cada cuántos segundos manda métricas a la tabla monitoreo.
MONITOR_INTERVAL=900
# Al arrancar, cuántas horas hacia atrás revisa para terminar partidos a medias.
RECOVERY_HOURS=3
# Proporción mínima de muestras "con personas" para publicar un partido (0.5 = 50 %).
ACTIVITY_THRESHOLD=0.5
# Subidas simultáneas a R2.
UPLOAD_WORKERS=8
