# Lacar Sports — configuración de UNA cámara. Vive en la Pi: /opt/lacar/.env.camaraN
# Se edita en la Pi con:   bash /opt/lacar/configurar.sh camaraN
# (las claves de R2/Supabase NO van aquí: están en /opt/lacar/comun.env)
#
# Formato: comentarios SOLO en líneas propias; valores entre comillas simples.

# Nombre de esta instancia: debe coincidir con el nombre del archivo (.env.camara1 → camara1).
INSTANCE_ID=camara1

# Cámara Dahua (IP fija en la red del complejo y su contraseña)
CAMERA_IP='192.168.1.108'
CAMERA_USER='admin'
CAMERA_PASS='CAMBIAR'

# Carpeta en R2: sin espacios ni tildes (ej. complejo-las-condes)
COMPLEJO='CAMBIAR'

# Estos tres deben ser IDÉNTICOS a la fila de la tabla `camaras` en Supabase
# (tildes y mayúsculas incluidas: 'Pádel', 'Fútbol 7').
COMPLEJO_NOMBRE='CAMBIAR'
DEPORTE='Pádel'
CANCHA='1'

# (Opcional) sobrescribir para esta cámara un valor de comun.env, por ejemplo:
# ACTIVITY_THRESHOLD=0.3
