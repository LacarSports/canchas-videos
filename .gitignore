# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# Lacar System — configs con secretos de las Raspberry (nunca commitear).
# El patrón .env* de arriba ya ignora los .env.camaraN; estas líneas cubren
# los nombres sin punto (env.camaraN...) y re-incluyen la plantilla de ejemplo.
Lacar System/env.*
# Claves reales (configs/comun.env, configs/respaldos/) y archivos antiguos archivados.
# Las plantillas comun.env.example y camara.env.example sí se commitean.
Lacar System/configs/
Lacar System/_antiguo/
__pycache__/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
